
# Application
NODE_ENV=development
PORT=3000

# Frontend URL allowed to access the backend
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL database connection
DATABASE_URL=postgres://username:password@localhost:5432/cg_explicit_services

# AI business audit
GEMINI_API_KEY=your_gemini_api_key_here

# Admin login — use placeholders only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Booking notification recipient
NOTIFY_EMAIL=sales@cgexplicitservices.com

# SMTP email configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=CG Explicit Services <info@cgexplicitservices.com>
