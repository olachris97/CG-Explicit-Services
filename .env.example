# Local development
GEMINI_API_KEY=your_gemini_api_key

# PostgreSQL connection string. Locally, point this at a Postgres instance
# running on your machine (or a free-tier hosted one you use for dev). On
# Render, create a PostgreSQL instance and paste its "Internal Database URL"
# (or "External Database URL" if connecting from outside Render) here.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=postgres://user:password@localhost:5432/cg_explicit_services

# Admin authentication
ADMIN_EMAIL=admin@cgexplicitservices.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Browser frontend origin(s), comma-separated for multiple origins
FRONTEND_ORIGIN=http://localhost:5173

# Netlify sets NETLIFY automatically in deployed functions.
